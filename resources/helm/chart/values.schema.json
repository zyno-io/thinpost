{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "workload",
    "control",
    "replicas"
  ],
  "properties": {
    "workload": {
      "enum": [
        "control",
        "edge"
      ],
      "description": "Which workload to render: the control plane or the Edge."
    },
    "database": {
      "type": "object",
      "required": [
        "caConfigMap"
      ],
      "additionalProperties": false,
      "properties": {
        "caConfigMap": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "description": "ConfigMap in the release namespace holding the Postgres CA bundle (key ca.crt)."
        }
      },
      "description": "Database connection settings for the control plane."
    },
    "replicas": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1,
      "description": "Edge replicas (0 or 1; the journal volume is single-writer)."
    },
    "image": {
      "type": "string",
      "description": "Edge worker image; falls back to bootstrapImage when empty."
    },
    "bootstrapImage": {
      "type": "string",
      "description": "Placeholder image used until image is set."
    },
    "addresses": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "address",
          "hostname"
        ],
        "additionalProperties": false,
        "properties": {
          "address": {
            "type": "string",
            "format": "ipv4",
            "description": "Public IPv4 address."
          },
          "hostname": {
            "type": "string",
            "maxLength": 219,
            "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
            "description": "Hostname for the greeting, HELO name, reverse DNS, certificate and bounce domain."
          },
          "certificateSecret": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "description": "kubernetes.io/tls Secret covering the hostname."
          },
          "range": {
            "type": "string",
            "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}$",
            "description": "Network CIDR; defaults to publicNetwork.range."
          },
          "gateway": {
            "type": "string",
            "format": "ipv4",
            "description": "Gateway; defaults to publicNetwork.gateway."
          },
          "master": {
            "type": "string",
            "minLength": 1,
            "description": "Parent interface; defaults to publicNetwork.master."
          },
          "mtu": {
            "type": "integer",
            "minimum": 576,
            "maximum": 9000,
            "description": "MTU; defaults to publicNetwork.mtu."
          }
        }
      },
      "description": "Every public sending address, one network attachment, listener and certificate each. The first entry is the main IP."
    },
    "control": {
      "type": "object",
      "required": [
        "replicas",
        "image",
        "bootstrapImage"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "anyOf": [
            {
              "const": 0
            },
            {
              "minimum": 2
            }
          ],
          "description": "Operator replicas: 0, or at least 2."
        },
        "image": {
          "type": "string",
          "description": "Control image; used by the operator and the hook Jobs."
        },
        "bootstrapImage": {
          "type": "string",
          "description": "Placeholder control image."
        },
        "tls": {
          "type": "object",
          "required": [
            "enabled",
            "secretName",
            "port"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable the HTTPS listener."
            },
            "secretName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
              "description": "Secret (tls.crt, tls.key) mounted for the listener."
            },
            "port": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535,
              "not": {
                "const": 8080
              },
              "description": "HTTPS listener port (not 8080)."
            }
          },
          "description": "Optional HTTPS listener beside the plain :8080 one."
        },
        "webhookInternalDestinations": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "description": "Exact internal webhook URLs the operator may deliver to."
        },
        "serviceCidrs": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Cluster Service CIDRs that internal destinations must resolve inside."
        },
        "migrations": {
          "type": "object",
          "required": [
            "enabled",
            "serviceAccount",
            "activeDeadlineSeconds"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Render the hook Jobs."
            },
            "serviceAccount": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
              "description": "ServiceAccount the Jobs run as (managed outside this chart)."
            },
            "activeDeadlineSeconds": {
              "type": "integer",
              "minimum": 60,
              "maximum": 3600,
              "description": "Hook Job deadline in seconds."
            }
          },
          "description": "Helm hook Jobs that migrate the schema and reopen the admission gate."
        },
        "deploymentAnnotations": {
          "type": "object",
          "description": "Extra annotations for the operator Deployment metadata.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "reloader": {
          "type": "object",
          "description": "Restart-on-secret-renewal annotation for the operator.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Add the Stakater Reloader annotation for thinpost-control-client."
            }
          }
        }
      },
      "description": "Control plane settings."
    },
    "node": {
      "type": "string",
      "description": "Optional node name to pin the Edge to; empty or \"unconfigured\" lets it float."
    },
    "workerId": {
      "type": "string",
      "description": "Edge worker identifier."
    },
    "controllerIdentity": {
      "type": "string",
      "description": "SPIFFE identity of the control plane the Edge trusts."
    },
    "controlClientCidrs": {
      "type": "array",
      "description": "CIDRs the control client may connect from.",
      "items": {
        "type": "string"
      }
    },
    "journalCapacity": {
      "type": "integer",
      "description": "Journal capacity (messages).",
      "minimum": 0
    },
    "journalReserveBytes": {
      "type": "integer",
      "description": "Journal bytes held in reserve.",
      "minimum": 0
    },
    "clockMargin": {
      "type": "string",
      "description": "Allowed clock skew, as a duration (for example 5s)."
    },
    "smtpRate": {
      "type": "object",
      "description": "SMTP rate limits.",
      "properties": {
        "globalInterval": {
          "type": "string",
          "description": "Interval between globally rate-limited sends (duration)."
        },
        "globalBurst": {
          "type": "integer",
          "description": "Global burst size.",
          "minimum": 0
        },
        "sourceInterval": {
          "type": "string",
          "description": "Interval between rate-limited sends per source (duration)."
        },
        "sourceBurst": {
          "type": "integer",
          "description": "Per-source burst size.",
          "minimum": 0
        }
      }
    },
    "publicNetwork": {
      "type": "object",
      "description": "Public network attachment settings; each addresses entry may override range, gateway, master and mtu.",
      "properties": {
        "master": {
          "type": "string",
          "description": "Parent interface for the attachment."
        },
        "range": {
          "type": "string",
          "description": "Default network CIDR for the addresses."
        },
        "gateway": {
          "type": "string",
          "description": "Default gateway."
        },
        "mtu": {
          "type": "integer",
          "description": "Interface MTU.",
          "minimum": 576,
          "maximum": 9000
        },
        "table": {
          "type": "integer",
          "description": "First source-based routing table; entry N uses table+N.",
          "minimum": 1
        },
        "attachmentLabels": {
          "type": "object",
          "description": "Labels added to every NetworkAttachmentDefinition.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "cniTypes": {
          "type": "object",
          "description": "CNI plugin binary names.",
          "properties": {
            "ipvlan": {
              "type": "string",
              "description": "ipvlan plugin type.",
              "minLength": 1
            },
            "sbr": {
              "type": "string",
              "description": "source-based-routing plugin type.",
              "minLength": 1
            }
          },
          "required": [
            "ipvlan",
            "sbr"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "description": "Image pull Secrets for every pod spec, as {name: ...} entries.",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Secret name.",
            "minLength": 1
          }
        }
      }
    },
    "smtpSubmission": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Open 587 (STARTTLS) and 465 (implicit TLS) on every sending IP, with each IP's own certificate."
        },
        "internal": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Open the in-cluster submission listener and its ClusterIP Service."
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "description": "Listener port on the pod address (also the Service target)."
            },
            "hostname": {
              "type": "string",
              "maxLength": 219,
              "description": "DNS name of the listener certificate."
            },
            "certificateSecret": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "description": "Secret with tls.crt, tls.key and ca.crt from the cluster-local CA."
            },
            "clientCidrs": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Source CIDRs allowed to connect."
            },
            "clientNamespaceSelector": {
              "type": "object",
              "description": "Namespace selector for allowed client namespaces."
            }
          },
          "description": "Optional in-cluster submission listener."
        }
      },
      "description": "Authenticated SMTP submission settings for the Edge workload."
    }
  }
}
