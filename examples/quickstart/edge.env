THINPOST_EDGE_WORKER_ID=quickstart-edge
THINPOST_EDGE_SMTP_HOSTNAME=smtp.quickstart.example
THINPOST_EDGE_BOUNCE_DOMAIN=bounce.quickstart.example
# Private control listener (edgectl network) and the "public" source address
# (edgepub network, an internal Docker network that never leaves the host).
THINPOST_EDGE_CONTROL_LISTEN=10.99.51.10:7443
THINPOST_EDGE_SMTP_LISTEN=11.42.51.10:25
# Authenticated SMTP submission on the same address and certificate: 587
# (STARTTLS) and 465 (implicit TLS). Port 25 is unchanged.
THINPOST_EDGE_SUBMISSION=true
THINPOST_EDGE_CONTROLLER_IDENTITIES=spiffe://quickstart.example/control
THINPOST_EDGE_CONTROL_CA=/pki/ca.crt
THINPOST_EDGE_CONTROL_CERT=/pki/edge-control.crt
THINPOST_EDGE_CONTROL_KEY=/pki/edge-control.key
THINPOST_EDGE_SMTP_CERT=/pki/smtp.crt
THINPOST_EDGE_SMTP_KEY=/pki/smtp.key
THINPOST_EDGE_JOURNAL_PATH=/journal/attempts.db
THINPOST_EDGE_JOURNAL_CAPACITY=1000
THINPOST_EDGE_JOURNAL_RESERVE_BYTES=1048576
THINPOST_EDGE_CLOCK_MARGIN=2s
# Outbound STARTTLS to the mail catcher verifies against the quickstart CA.
SSL_CERT_FILE=/pki/ca.crt
