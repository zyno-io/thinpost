# Non-secret control-plane settings. Secrets (database password, S3 secret,
# journal identity) are added by run-control.sh from the generated /pki volume.
THINPOST_LISTEN=0.0.0.0:8080
# Fixed development generation; the database gate is opened with it by db-init.
THINPOST_DEPLOYMENT_GENERATION=00000000000000000000000000000001
# Loopback-only insecure database and object store (shared network namespace).
THINPOST_ALLOW_INSECURE_LOCAL_DB=1
THINPOST_ALLOW_INSECURE_LOCAL_S3=1
THINPOST_S3_ENDPOINT=127.0.0.1:4566
THINPOST_S3_BUCKET=thinpost
THINPOST_S3_REGION=us-east-1
THINPOST_S3_ACCESS_KEY=quickstart
THINPOST_OBJECT_KEYRING_FILE=/pki/object-keyring.json
# Operator authentication: standard `scope` and `roles` claims from the dev issuer.
THINPOST_OIDC_ISSUER=https://localhost:8443/idp
THINPOST_OIDC_JWKS_URL=https://caddy:8443/idp/jwks
THINPOST_OIDC_AUDIENCE=thinpost-api
THINPOST_OIDC_CLIENT_ID=thinpost-console
THINPOST_OIDC_SCOPES=openid profile thinpost-admin
THINPOST_OIDC_ADMIN_SCOPE=thinpost-admin
THINPOST_OIDC_ADMIN_ROLE=Thinpost.Admin
# Trust Caddy's local root for the JWKS fetch.
SSL_CERT_FILE=/caddy-root/caddy-root.crt
# Submission and the Edge bridge. DKIM keys are generated by control and sealed
# with the object keyring, so there is no signing catalog.
THINPOST_CONTROL_FINGERPRINT_KEYS_FILE=/pki/fingerprint-keys.json
THINPOST_RECIPIENT_POLICY=allowlist
THINPOST_RECIPIENT_ALLOWLIST_FILE=/qs/recipients.txt
THINPOST_CONTROL_EDGE_TARGET=10.99.51.10:7443
THINPOST_CONTROL_WORKER_ID=quickstart-edge
THINPOST_CONTROL_INSTANCE_ID=quickstart-control
THINPOST_CONTROL_IDENTITY=spiffe://quickstart.example/control
THINPOST_CONTROL_EDGE_DNS=edge.quickstart.example
THINPOST_CONTROL_EDGE_IDENTITY=spiffe://quickstart.example/edge
THINPOST_CONTROL_PRIVATE_CA=/pki/ca.crt
THINPOST_CONTROL_CLIENT_CERT=/pki/control-client.crt
THINPOST_CONTROL_CLIENT_KEY=/pki/control-client.key
THINPOST_CONTROL_BOUNCE_ACTIVE_KEY=v1
THINPOST_CONTROL_BOUNCE_KEYS_FILE=/pki/bounce-keys.json
THINPOST_CONTROL_INFRASTRUCTURE_CIDRS=11.42.51.0/24
THINPOST_CONTROL_ROUTE_EXCEPTIONS_FILE=/qs/route-exceptions
