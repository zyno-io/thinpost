# Authoritative local DNS for quickstart.example. The zone is generated by
# pki-init into a volume; smoke.sh appends the sender-domain verification TXT
# and bumps the SOA serial, which the file plugin notices within a second.
quickstart.example:53 {
	file /zone/quickstart.example.zone {
		reload 1s
	}
	errors
}

# Reverse DNS for the Edge's address, as an IP provider would publish it. The
# console only shows the SMTP host once forward and reverse DNS agree.
51.42.11.in-addr.arpa:53 {
	file /zone/edge-reverse
	errors
}
